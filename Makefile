# Compiler
CXX = g++

# Compiler Flags
# 	-Wall and -Wextra are for warnings
# 	-g includes debugging info
# 	-MMD: generates a dependency file listing the user headers included by each source file.
# 	-MP: adds dummy targets for headers, helping avoid errors if a header is removed or renamed.
CXXFLAGS = -std=c++20 -Wall -Wextra -g -MMD -MP

# Project Directories
SRC_DIR = src
INCLUDE_DIR = include

# Npcap SDK Paths
NPCAP_DIR = /c/dev/npcap-sdk-1.16
NPCAP_INCLUDE = $(NPCAP_DIR)/Include
NPCAP_LIB = $(NPCAP_DIR)/Lib/x64

# Executable
TARGET = PacketSniffer.exe

# Source Files
# Finds every .cpp file inside of src/
SOURCES = 	$(wildcard $(SRC_DIR)/*.cpp) \
			$(wildcard $(SRC_DIR)/packetCapture/*.cpp) \
			$(wildcard $(SRC_DIR)/packetFormat/*.cpp) \
			$(wildcard $(SRC_DIR)/packetParser/*.cpp) \
			$(wildcard $(SRC_DIR)/packetPrinter/*.cpp)

# Object files: one .o file for each .cpp file
OBJECTS = $(SOURCES:.cpp=.o)

# Header dependency files generated by the compiler
DEPENDS = $(OBJECTS:.o=.d)

# Include paths
CPPFLAGS = -I$(INCLUDE_DIR) -I$(NPCAP_INCLUDE)

# Npcap libraries and Windows networking library
LDLIBS = "$(NPCAP_LIB)/wpcap.lib" \
         "$(NPCAP_LIB)/Packet.lib" \
         -lws2_32

# Default target
.PHONY: all clean

all: $(TARGET)

# Link object files into the executable
$(TARGET): $(OBJECTS)
	$(CXX) $(OBJECTS) $(LDFLAGS) $(LDLIBS) -o $@

# Compile each source file into an object file
%.o: %.cpp
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@

# Include automatically generated header dependencies
-include $(DEPENDS)

# Remove generated files
clean:
	rm -f $(TARGET) $(OBJECTS) $(DEPENDS)
